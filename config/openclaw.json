{
  "models": {
    "providers": {
      "ollama": {
        "baseUrl": "http://127.0.0.1:11434",
        "api": "ollama",
        "maxTokens": 100,
        "models": [
          {
            "id": "phi4-mini:latest",
            "name": "Phi-4 Mini (100% Free Local CPU)",
            "contextWindow": 1024,
            "contextTokens": 1024,
            "maxTokens": 100,
            "params": {
              "num_ctx": 1024,
              "num_predict": 100,
              "num_thread": 8,
              "keep_alive": "60m"
            }
          },
          {
            "id": "qwen2.5:7b",
            "name": "Qwen 2.5 7B (100% Free Local CPU)",
            "contextWindow": 1024,
            "contextTokens": 1024,
            "maxTokens": 100,
            "params": {
              "num_ctx": 1024,
              "num_predict": 100,
              "num_thread": 8,
              "keep_alive": "60m"
            }
          }
        ]
      }
    }
  },
  "tools": {
    "profile": "minimal"
  },
  "agents": {
    "defaults": {
      "workspace": "data/workspace",
      "contextInjection": "never",
      "bootstrapMaxChars": 200,
      "bootstrapTotalMaxChars": 500,
      "thinkingDefault": "off",
      "model": {
        "primary": "ollama/phi4-mini:latest",
        "fallbacks": [
          "ollama/qwen2.5:7b"
        ]
      }
    },
    "entries": {
      "gagan": {
        "name": "Gagan",
        "description": "Personal AI Assistant for Gagan Rajput"
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "open",
      "allowFrom": [
        "*"
      ]
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "none"
    }
  }
}
