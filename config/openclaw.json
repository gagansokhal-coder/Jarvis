{
  "agents": {
    "defaults": {
      "model": {
        "primary": "ollama/qwen2.5:7b",
        "fallbacks": [
          "groq/llama-3.3-70b-versatile",
          "google/gemini-2.5-flash"
        ]
      }
    },
    "entries": {
      "gagan": {
        "name": "Gagan",
        "description": "Personal AI Assistant for Gagan Rajput"
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "open",
      "allowFrom": [
        "*"
      ]
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "none"
    }
  }
}
